// Reference only — this repo has no Firebase CLI/deploy tooling.
// Paste this into the Firebase console: Firestore Database → Rules tab → Publish.
//
// One document per sharing owner, keyed by their Firebase Anonymous-Auth
// uid (which is also the `share` query param in the link they hand out).
// Anyone who is at least anonymously signed in can read a doc if they
// know its uid (the uid embedded in the link *is* the access control,
// same trust model as an unlisted Google Doc link) — but only the
// matching signed-in identity can write it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shares/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size() < 900000; // headroom under the 1 MiB/doc cap
    }
  }
}
